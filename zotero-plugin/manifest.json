{
  "manifest_version": 2,
  "name": "search4paper",
  "version": "0.1.3",
  "description": "按会议和年份检索 ICML、NeurIPS、ICLR、AAAI、ACL、CVPR、ICCV、EMNLP、ECCV、CRYPTO、EUROCRYPT、ASIACRYPT 论文，筛选关键词并导入 Zotero。",
  "applications": {
    "zotero": {
      "id": "search4paper@local",
      "update_url": "https://raw.githubusercontent.com/maojianhuan/serach4paper/main/zotero-plugin/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.0.*"
    }
  }
}
